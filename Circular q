#include<stdio.h>
#include<stdlib.h>

#define size 100

int front = -1, rear = -1, queue[size];


void enq() {
    int value;

    if((rear + 1) % size == front) {
        printf("\noverflow\n");
        return;
    }
    else {
        if(front == -1) {
            front = 0;
            rear = 0;
        }
        else {
            rear = (rear + 1) % size;
        }

        printf("\nenter value to push: \n");
        scanf("%d", &value);

        queue[rear] = value;
    }
}


void deq() {

    if(front == -1) {
        printf("\nunderflow\n");
        return;
    }
    else {

        printf("\ndequeued value %d\n", queue[front]);

        if(front == rear) {
            front = -1;
            rear = -1;
        }
        else {
            front = (front + 1) % size;
        }
    }
}


void display() {

    if(front == -1) {
        printf("\nempty\n");
        return;
    }
    else {

        printf("\nthe Queue is\n");

        int i = front;

        while(1) {

            printf("%d ", queue[i]);

            if(i == rear) {
                break;
            }

            i = (i + 1) % size;
        }
    }
}


void displayfront() {

    if(front == -1) {
        printf("empty\n");
    }
    else {
        printf("queue front: %d\n", queue[front]);
    }
}


int main() {

    int choice;

    printf("the operation are 1 enq 2 deq 3 display 4 display front 5 exit\n");

    while(1) {

        printf("\nenter choice ");
        scanf("%d", &choice);

        switch(choice) {

            case 1:
                enq();
                break;

            case 2:
                deq();
                break;

            case 3:
                display();
                break;

            case 4:
                displayfront();
                break;

            case 5:
                exit(0);

            default:
                printf("invalid\n");
                break;
        }
    }

    return 0;
}
